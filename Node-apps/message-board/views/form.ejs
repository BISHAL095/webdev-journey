<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create New Message</title>

  <!-- Link to CSS -->
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <div class="container">
    <h1>Create New Message</h1>

    <div class="form-card">
      <form action="/new" method="POST">

        <div class="form-group">
          <label for="user">Your Name</label>
          <input type="text" id="user" name="user" placeholder="Enter your name" required />
        </div>

        <div class="form-group">
          <label for="text">Your Message</label>
          <textarea id="text" name="text" rows="4" placeholder="Write your message..." required></textarea>
        </div>

        <button class="button" type="submit">Submit Message</button>

      </form>
    </div>

    <br>
    <a href="/">← Back to Home</a>
  </div>

</body>
</html>